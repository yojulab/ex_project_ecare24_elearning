{
  "name": "ecare24",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend_user",
    "frontend_admin",
    "mobileApp"
  ],
  "scripts": {
    "start": "bash start_server.sh",
    "stop": "bash stop_server.sh",
    "restart": "bash restart_server.sh",
    "dev:all": "bash run_port.sh all",
    "dev:user": "bash run_port.sh 30010",
    "dev:admin": "bash run_port.sh 30011",
    "dev:mobile": "bash run_port.sh 30012",
    "dev:30010": "bash run_port.sh 30010",
    "dev:30011": "bash run_port.sh 30011",
    "dev:30012": "bash run_port.sh 30012",
    "compile": "bash run_port.sh build all",
    "compile:all": "bash run_port.sh build all",
    "compile:user": "bash run_port.sh build 30010",
    "compile:admin": "bash run_port.sh build 30011",
    "compile:mobile": "bash run_port.sh build 30012",
    "port": "bash run_port.sh",
    "tunnel:share": "bash scripts/start_tunnels.sh",
    "tunnel:status": "bash scripts/status_tunnels.sh"
  }
}
