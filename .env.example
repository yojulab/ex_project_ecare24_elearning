# ==============================================================================
# eCare24 이러닝 멀티 프로젝트 통합 환경 변수 마스터 가이드 (.env.example)
# ==============================================================================
# 각 하위 패키지 디렉토리에 .env 파일을 복사하여 사용합니다.
#
# 1. frontend_user  : http://localhost:30010 (수강생 포털)
# 2. frontend_admin : http://localhost:30011 (관리자/콜센터 포털)
# 3. mobileApp      : http://localhost:30012 (모바일 시뮬레이터)
# 4. backend        : http://localhost:30014 (엔터프라이즈 REST API & Swagger)
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] backend/.env (NestJS REST API 서버)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=30014
API_PREFIX=/api/v1
CORS_ORIGINS=*

# PostgreSQL 16+ 연결 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecare24
DB_USER=ecare24_app
DB_PASSWORD=__YOUR_DB_PASSWORD__
DB_SSL=false
DB_SYNCHRONIZE=false

# 보안 및 JWT 토큰 설정 (최소 64자 권장)
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET_64_CHARS_MINIMUM__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET_64_CHARS_MINIMUM__
JWT_REFRESH_EXPIRES_IN=14d
BCRYPT_COST=10

# 개인정보 암호화 (AES-256-GCM 32바이트 base64) & HMAC 키
PII_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMmJ5dGUtZW5jcnlwdGlvbi1rZXk=
HMAC_SECRET=__HMAC_SECRET_KEY__
CERT_QR_BASE_URL=http://localhost:30010/verify

# 초기 관리자 계정 시드
SEED_SUPER_ADMIN_LOGIN_ID=admin
SEED_SUPER_ADMIN_PASSWORD=__SUPER_ADMIN_PASSWORD__
SEED_SUPER_ADMIN_NAME=시스템관리자
SEED_SUPER_ADMIN_PHONE=010-0000-0000
SEED_DEMO_DATA=false

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# [2] frontend_user/.env (수강생 웹 포털 - Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:30014/api/v1
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:30011
NEXT_PUBLIC_APP_NAME=한국돌봄종사자양성교육원

# ------------------------------------------------------------------------------
# [3] frontend_admin/.env (관리자 및 콜센터 - Vite React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:30014/api/v1
VITE_API_DOCS_URL=http://localhost:30014/api/docs
VITE_USER_PORTAL_URL=http://localhost:30010
VITE_APP_NAME=eCare24 콜센터 & 통합 관리자

# ------------------------------------------------------------------------------
# [4] mobileApp/.env (모바일 시뮬레이터 - Expo / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:30014/api/v1
EXPO_PUBLIC_API_URL=http://localhost:30014/api/v1
VITE_USER_PORTAL_URL=http://localhost:30010
EXPO_PUBLIC_USER_PORTAL_URL=http://localhost:30010
VITE_CERT_VERIFY_URL=http://localhost:30010/verify
EXPO_PUBLIC_CERT_VERIFY_URL=http://localhost:30010/verify
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CDN_BASE_URL=https://cdn.ecare24.kr
EXPO_PUBLIC_DEEP_LINK_SCHEME=ecare24://
EXPO_PUBLIC_FCM_PROJECT_ID=ecare24-push-firebase
