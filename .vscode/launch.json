{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend User: Next.js (Port 3000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend_user",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Frontend Admin: React Admin Vite (Port 3001)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend_admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "mobileApp: Mobile Web Simulator (Port 3002)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/mobileApp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "(선택) Chrome 디버거 연결 (Attach only - Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack: 3개 서버 동시 실행 (:3000, :3001, :3002)",
      "configurations": [
        "Frontend User: Next.js (Port 3000)",
        "Frontend Admin: React Admin Vite (Port 3001)",
        "mobileApp: Mobile Web Simulator (Port 3002)"
      ]
    }
  ]
}
