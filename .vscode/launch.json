{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend User: Next.js (Port 30010)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend_user",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Frontend Admin: React Admin Vite (Port 30011)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend_admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "mobileApp: Mobile Web Simulator (Port 30012)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/mobileApp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "(선택) Chrome 디버거 연결 (Attach only - Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack: 3개 서버 동시 실행 (:30010, :30011, :30012)",
      "configurations": [
        "Frontend User: Next.js (Port 30010)",
        "Frontend Admin: React Admin Vite (Port 30011)",
        "mobileApp: Mobile Web Simulator (Port 30012)"
      ]
    }
  ]
}
